# Local PostgreSQL
DATABASE_URL=postgresql+psycopg://openlivery:openlivery@localhost:5432/openlivery

# Change these keys before using real data (at least 32 characters)
SECRET_KEY=change-this-long-random-key-in-production
ENCRYPTION_KEY=change-this-other-long-random-key

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000

# Session cookie flags. Behind HTTPS set COOKIE_SECURE=true. If the frontend and
# API are on different sites, set COOKIE_SAMESITE=none (which requires
# COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Public backend URL used by Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Baileys bridge. Use the same long random value in FastAPI and Node.
BACKEND_URL=http://localhost:8000
WHATSAPP_BRIDGE_URL=http://localhost:3101
WHATSAPP_BRIDGE_PORT=3101
WHATSAPP_BRIDGE_TOKEN=generate-a-long-random-token-for-the-bridge

# WhatsApp Cloud API (official Meta API). Channel credentials can still be
# configured per client in Advanced settings (BYO Meta app). For managed
# Embedded Signup, set the platform Meta App values below.
# META_GRAPH_BASE_URL=https://graph.facebook.com/v23.0
# META_APP_ID=
# META_APP_SECRET=
# META_WHATSAPP_CONFIG_ID=
# META_MOCK_MODE=false
# META_OAUTH_REDIRECT_PATH=/api/whatsapp-cloud/oauth/callback

# Instagram Content Publishing (reuses META_APP_ID / META_APP_SECRET for OAuth).
# INSTAGRAM_PUBLISHING_MOCK_MODE=true
# INSTAGRAM_OAUTH_REDIRECT_PATH=/api/instagram/oauth/callback
# INSTAGRAM_CONTAINER_POLL_MAX_ATTEMPTS=30
# INSTAGRAM_CONTAINER_POLL_DELAY_SECONDS=2
# INSTAGRAM_SCHEDULER_INTERVAL_SECONDS=20

# Google Identity Services (optional). Leave empty to hide Google buttons.
# GOOGLE_OAUTH_CLIENT_ID=
# Expose raw reset tokens in API responses (local/tests only).
# AUTH_EXPOSE_RESET_TOKEN=false
